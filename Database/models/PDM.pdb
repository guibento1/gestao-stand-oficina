<a:ObjectID>C05F0D50-1229-491B-AA36-6E7E0E25ACD2</a:ObjectID>
<a:Name>servico_pecas</a:Name>
<a:Code>servico_pecas</a:Code>
<a:CreationDate>1768929335</a:CreationDate>
<a:Creator>bento</a:Creator>
<a:ModificationDate>1768929336</a:ModificationDate>
<a:Modifier>bento</a:Modifier>
<a:ServerCheckExpression>preco_total = preco_unitario * quantidade</a:ServerCheckExpression>
<a:PhysicalOptions>CREATE TABLE reservas (
   reserva_id      SERIAL PRIMARY KEY,
   cliente_id      INT NOT NULL,
   carro_id        INT NOT NULL,
   data_reserva    DATE NOT NULL DEFAULT CURRENT_DATE,
   data_teste      DATE,
   estado          VARCHAR(20) NOT NULL DEFAULT &#39;pendente&#39; CHECK (estado IN (&#39;pendente&#39;, &#39;confirmada&#39;, &#39;cancelada&#39;, &#39;expirada&#39;)),
   observacoes     TEXT,
   criado_por_id   INT,
   CONSTRAINT FK_RESERVAS_CLIENTE FOREIGN KEY (cliente_id)
      REFERENCES clientes (cliente_id) ON DELETE RESTRICT,
   CONSTRAINT FK_RESERVAS_CARRO FOREIGN KEY (carro_id)
      REFERENCES carros (carro_id) ON DELETE RESTRICT,
   CONSTRAINT FK_RESERVAS_CRIADO_POR FOREIGN KEY (criado_por_id)
      REFERENCES utilizadores (user_id) ON DELETE SET NULL
)</a:PhysicalOptions>
<a:CheckConstraintName>chk_servicopecas_total</a:CheckConstraintName>
<a:TotalSavingCurrency/>
